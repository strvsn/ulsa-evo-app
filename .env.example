# The bundled Cloudflare Worker uses same-origin /api routes in a Web deployment.
# Capacitor/iOS builds need the absolute credential-free Worker catalog URL.
# These values are embedded in the client and are not secrets.
# VITE_ESP32_FIRMWARE_RELEASES_URL=https://app.example.invalid/api/firmware/releases
# VITE_STM32_FIRMWARE_RELEASES_URL=https://app.example.invalid/api/stm32-firmware/releases
# build:release-web enables the encrypted STM32 updater. The official private
# production environment is not exported. Never substitute a secret/admin token.

VITE_SUPPORT_URL=https://ulsa-evo-start.pages.dev/support/
VITE_PRIVACY_POLICY_URL=https://ulsa-evo-start.pages.dev/privacy/
