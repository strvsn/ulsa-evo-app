{
  "name": "ulsa-evo-app",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "dev:https": "node scripts/dev-https.mjs",
    "build": "tsc && vite build && node scripts/build-pwa-service-worker.mjs",
    "build:release-web": "VITE_STM32_UPDATER_ENABLED=true npm run build",
    "preview": "vite preview",
    "test.e2e": "cypress run",
    "test.unit": "vitest",
    "lint": "eslint",
    "verify:docs": "node scripts/verify-ble-docs.mjs",
    "verify:ios-assets": "node scripts/verify-ios-web-assets.mjs",
    "verify:pwa-offline": "node --test scripts/pwa-offline.node-test.mjs && node scripts/build-pwa-service-worker.mjs --verify",
    "verify:wind-rose-parity": "node scripts/verify-wind-rose-parity.mjs",
    "verify:public-source": "node scripts/public-source/verify.mjs",
    "worker:types": "wrangler types ../../worker-configuration.d.ts --cwd cloudflare/staging --include-runtime false --strict-vars false",
    "worker:types:check": "wrangler types ../../worker-configuration.d.ts --cwd cloudflare/staging --include-runtime false --strict-vars false --check",
    "worker:typecheck": "tsc -p tsconfig.worker.json",
    "worker:test": "vitest run --config vitest.worker.config.ts",
    "worker:dry-run": "wrangler deploy --dry-run --env staging --outdir .wrangler/dry-run",
    "worker:verify": "npm run worker:types:check && npm run worker:typecheck && npm run worker:test",
    "pages:package": "node scripts/build-cloudflare-pages.mjs",
    "pages:package:release": "VITE_STM32_UPDATER_ENABLED=true npm run pages:package",
    "pages:verify": "node --test scripts/release-identity.node-test.mjs && node scripts/build-cloudflare-pages.mjs --verify",
    "pages:dev": "node scripts/cloudflare-pages-dev.mjs",
    "pages:smoke": "node scripts/cloudflare-pages-smoke.mjs",
    "cloudflare:deployment-digest": "node scripts/cloudflare-deploy-digest.mjs",
    "cap:sync:ios": "npx cap sync ios",
    "sync:ios": "npm run build && npm run cap:sync:ios && npm run verify:ios-assets",
    "verify": "npm run lint && npm run test.unit -- --run && npm run build:release-web && npm run verify:pwa-offline && npm run worker:verify && npm run verify:docs && npm run verify:public-source && npm run pages:package:release && npm run pages:verify && npm run cap:sync:ios && npm run verify:ios-assets",
    "build:ios": "npm run verify:wind-rose-parity && npm run build:release-web && npm run cap:sync:ios && npm run verify:ios-assets && node scripts/xcodebuild-ios.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.1.3",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@ionic/react": "^8.5.0",
    "@ionic/react-router": "^8.5.0",
    "@tabler/icons-react": "^3.44.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.5",
    "fflate": "^0.8.3",
    "ionicons": "^7.4.0",
    "lucide-react": "^1.24.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "swiper": "^12.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@cloudflare/vitest-pool-workers": "^0.12.20",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@testing-library/dom": ">=7.21.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-react": "^4.0.1",
    "cypress": "15.21.1",
    "esbuild": "0.25.12",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^22.1.0",
    "terser": "^5.4.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "wrangler": "^4.129.0"
  },
  "description": "ULSA EVO Web BLE and Capacitor/iOS companion app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/strvsn/ulsa-evo-app.git"
  },
  "homepage": "https://github.com/strvsn/ulsa-evo-app#readme",
  "engines": {
    "node": ">=24 <25"
  }
}
